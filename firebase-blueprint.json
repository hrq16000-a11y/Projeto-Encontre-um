{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "business_owner"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Business": {
      "title": "Business",
      "description": "Business listing information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "ownerId": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "premium", "gold"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "city", "ownerId"]
    },
    "Review": {
      "title": "Review",
      "description": "Business review",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "userId", "rating"]
    },
    "Ad": {
      "title": "Ad",
      "description": "Classified advertisement",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "city": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "sold", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "userId", "price"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "businesses/{businessId}": {
      "schema": "Business",
      "description": "Business listings"
    },
    "businesses/{businessId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Reviews for a specific business"
    },
    "ads/{adId}": {
      "schema": "Ad",
      "description": "Classified ads"
    }
  }
}
